# Impeccable çalışma çıktıları — yayına gitmez.
# İnceleme ekran görüntüleri ve kalite çıtası referansları 11 MB tutuyor ve
# sitenin sunduğu hiçbir şeyle ilgisi yok.
.impeccable/review/
.impeccable/quality-bar/
.impeccable/questions/
.impeccable/mocks/

.DS_Store
.hugo_build.lock

# Çalışma belgeleri — repoda dursun ama yayına gitmesin.
# GitHub Pages repodaki her dosyayı sunuyor; bunlar ubeydgencer.com/PRODUCT.md
# gibi adreslerden herkese açık hâle geliyordu.
# Kopyaları: ~/Desktop/ubeydgencer-tasarim-belgeleri/
PRODUCT.md
DESIGN.md
.impeccable/

# Raindrop token — asla repoya girmesin.
# Bu token Raindrop hesabının tamamına okuma VE yazma yetkisi veriyor.
.env

# Hugo kalıntısı — site elle yazılmış HTML, Hugo kullanılmıyor.
.hugo_build.lock
